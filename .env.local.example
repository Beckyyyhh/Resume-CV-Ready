# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it's already gitignored.

# Gmail account used to send the "email me a copy" feature on the
# resume/cover letter Finalise step. Without these set, that button
# shows a friendly error and the rest of the site works normally.
#
# GMAIL_USER is the full Gmail address to send from.
# GMAIL_APP_PASSWORD is a 16-character App Password (NOT your normal
# Gmail password) — generate one at https://myaccount.google.com/apppasswords
# after turning on 2-Step Verification for that Google account.
GMAIL_USER=
GMAIL_APP_PASSWORD=

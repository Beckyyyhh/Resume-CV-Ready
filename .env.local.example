# Copy this file to .env.local and fill in your own value.
# Never commit .env.local — it's already gitignored.

# API key for Resend (https://resend.com), used to power the "email me a copy"
# button on the resume/cover letter Finalise step. Without this set, that
# button shows a friendly error and the rest of the site works normally.
RESEND_API_KEY=
